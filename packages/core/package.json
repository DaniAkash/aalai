{
  "name": "aalai",
  "version": "0.0.1",
  "description": "A local software factory: watches your repositories, turns issues into reviewed draft pull requests.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaniAkash/aalai.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/DaniAkash/aalai#readme",
  "bugs": {
    "url": "https://github.com/DaniAkash/aalai/issues"
  },
  "keywords": [
    "agent",
    "acp",
    "github",
    "automation",
    "pull-request",
    "bun"
  ],
  "engines": {
    "bun": ">=1.3.0",
    "node": ">=20"
  },
  "type": "module",
  "bin": "./bin/aalai.mjs",
  "files": [
    "bin",
    "src",
    "tsconfig.json",
    "README.md"
  ],
  "exports": {
    "./events": "./src/events/events.types.ts",
    "./client": "./src/server/client.ts",
    "./shared": "./src/shared/format.ts"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "once": "bun run src/index.ts --once",
    "run-issue": "bun run src/index.ts run",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./test/",
    "eval": "bun test ./evals/",
    "service": "bun run scripts/service.ts",
    "e2e:gates": "bun run scripts/gate-e2e.ts",
    "e2e:api": "bun run scripts/gate-api-e2e.ts",
    "e2e": "bun run e2e:gates && bun run e2e:api"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "acpx": "^0.18.0",
    "acpx-ai-provider": "^1.0.0",
    "ai": "^7.0.107",
    "chalk": "^6.0.0",
    "cli-table3": "^0.6.5",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.8",
    "log-symbols": "^7.0.1",
    "terminal-link": "^5.0.0",
    "xstate": "^5.33.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  }
}
