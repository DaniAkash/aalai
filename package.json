{
  "name": "aalai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "app/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun run --filter 'aalai-core' test",
    "eval": "bun run --filter 'aalai-core' eval",
    "start": "bun run --filter 'aalai-core' start",
    "once": "bun run --filter 'aalai-core' once",
    "service": "bun run --filter 'aalai-core' service",
    "build:sidecar": "bun scripts/build-sidecar.ts",
    "dev:native": "bun run --filter aalai-native dev"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
