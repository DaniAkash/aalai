{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capabilities the aalai window needs",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "notification:default",
    "opener:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/aalai-core", "sidecar": true }]
    },
    {
      "identifier": "http:default",
      "allow": [{ "url": "http://127.0.0.1:*" }]
    }
  ]
}
