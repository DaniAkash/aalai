{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    // "bun" is here because the RPC client type-imports AppType from the
    // factory, and TypeScript must then check that file's transitive imports,
    // which touch Bun globals. The cost is that Bun APIs also typecheck inside
    // UI code; the alternative is mirroring the contract by hand, which is the
    // drift this import exists to prevent.
    "types": ["vite/client", "bun"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    "paths": {
      "@/*": ["./src/*", "../../packages/core/src/*"]
    }
  },
  "include": ["src"]
}
